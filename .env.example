APP_ENV=development
LOG_LEVEL=INFO

PIAULE_API_HOST=127.0.0.1
PIAULE_API_PORT=8000
PIAULE_SESSION_SECRET=
PIAULE_DATABASE_URL=sqlite:///./piaule-fiction.db

# Connexion Google : OpenID Connect uniquement (openid email profile), jamais Gmail.
PIAULE_GOOGLE_CLIENT_ID=
PIAULE_GOOGLE_CLIENT_SECRET=
PIAULE_GOOGLE_REDIRECT_URI=http://127.0.0.1:8000/api/auth/google/callback
PIAULE_FRONTEND_REDIRECT_URI=http://127.0.0.1:5173/espace.html

# Développement uniquement : ne jamais activer en production.
PIAULE_EXPOSE_DEV_RESET_TOKEN=false

# Fournisseur IA : ne jamais committer une vraie clé.
PIAULE_LLM_API_KEY=
PIAULE_LLM_MODEL=

# Courriel : désactivé par défaut pendant le développement.
PIAULE_EMAIL_ENABLED=false
PIAULE_SMTP_HOST=
PIAULE_SMTP_PORT=587
PIAULE_SMTP_USERNAME=
PIAULE_SMTP_PASSWORD=
PIAULE_SMTP_FROM=

# Réception des candidatures envoyées depuis les annonces externes.
# Le domaine doit être configuré chez le fournisseur de messagerie entrant.
PIAULE_APPLICATION_EMAIL_DOMAIN=piaulefiction.fr
# Secret partagé avec le webhook du fournisseur entrant ; ne jamais committer sa valeur.
PIAULE_INBOUND_WEBHOOK_TOKEN=

# DossierFacile Connect : renseigner uniquement après accord partenaire.
PIAULE_DOSSIER_FACILE_ENABLED=false
PIAULE_DOSSIER_FACILE_CLIENT_ID=
PIAULE_DOSSIER_FACILE_CLIENT_SECRET=
PIAULE_DOSSIER_FACILE_AUTH_URL=https://sso-preprod.dossierfacile.fr/auth/realms/dossier-facile/protocol/openid-connect/auth
PIAULE_DOSSIER_FACILE_TOKEN_URL=https://sso-preprod.dossierfacile.fr/auth/realms/dossier-facile/protocol/openid-connect/token
PIAULE_DOSSIER_FACILE_PROFILE_URL=https://api-preprod.dossierfacile.fr/dfc/tenant/profile
PIAULE_DOSSIER_FACILE_REDIRECT_URI=
PIAULE_DOSSIER_FACILE_WEBHOOK_TOKEN=

# Paiement : à activer uniquement après validation du parcours candidat.
PIAULE_STRIPE_SECRET_KEY=
PIAULE_STRIPE_WEBHOOK_SECRET=
