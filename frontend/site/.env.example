# Copier ce fichier en .env pour changer les réglages du serveur de développement.
# Aucune valeur secrète ici : le frontend n'utilise aucune clé.

# Port et adresse du serveur local
PORT=5173
HOST=127.0.0.1

# mock  = API simulée en mémoire (comptes perdus à l'arrêt du serveur)
# proxy = /api/* est relayé vers API_TARGET (votre backend)
API_MODE=mock
API_TARGET=http://127.0.0.1:8000
